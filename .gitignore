# Downloaded elevation data (large raster DEM files)
data/raw/dem/*
!data/raw/dem/.gitkeep
!data/raw/dem/*.sample.*

# Downloaded OSM data (large raw extracts)
data/raw/osm/*
!data/raw/osm/.gitkeep
!data/raw/osm/*.sample.geojson
!data/raw/osm/sample_*

# Processed intermediate data (can be regenerated by prepare_data.py)
# Keep .gitkeep
!data/processed/rainfall/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Node
node_modules/
dist/

# SQLite databases & runtime storage
*.db
*.sqlite3
*.db-wal
*.db-shm
data/uploads/reports/*
!data/uploads/reports/.gitkeep
data/uploads/*.png

# macOS
.DS_Store

# Environment secrets (keep the example file)
.env
.env.*
!.env.example

